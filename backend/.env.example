SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_KEY=your-service-role-key
PORT=3000

# Who receives the submitted-form email (comma-separate for several)
ADMIN_EMAIL=admin@example.com

# Email via Brevo HTTPS API (required on Render free tier — SMTP ports are blocked there)
# Get the key at app.brevo.com → SMTP & API → API Keys. SENDER_EMAIL must be a verified sender in Brevo.
BREVO_API_KEY=your-brevo-api-key
SENDER_EMAIL=your-gmail@gmail.com

# SMTP fallback for local use only (use Gmail App Password)
SMTP_USER=your-gmail@gmail.com
SMTP_PASS=your-16-digit-app-password

# CC email(s) for sub-admin notifications (comma-separate for several)
CC_EMAIL=another-email@gmail.com
